# Application
APP_PORT=8080

# Database
# Use localhost:5433 when the application runs on the host with compose.dev.yaml.
# compose.prod.yaml overrides DB_HOST to postgres and DB_PORT to 5432 in containers.
DB_HOST=localhost
DB_PORT=5433
DB_USER=flowpocket
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=flowpocket

# Docker Compose host ports
POSTGRES_HOST_PORT=5433
POSTGRES_ADMIN_PORT=5434

# Docker image used by compose.prod.yaml
# Prefer an immutable sha-* or version tag for staging and production.
IMAGE_TAG=latest

# Authentication
# Must contain at least 32 characters.
SESSION_TOKEN_SECRET=replace-with-a-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cloudflare R2 / S3-compatible storage
S3_ACCOUNT_ID=replace-with-r2-account-id
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_BUCKET_NAME=replace-with-r2-bucket-name
S3_PUBLIC_URL=https://example.com
