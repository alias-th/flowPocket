{
  "name": "flowpocket",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create ./src/migrations/SwitchFeatRefreshToken",
    "migration:generate": "npm run typeorm -- migration:generate ./src/migrations/SwitchFeatRefreshToken -d ./src/datasource.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./src/datasource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/datasource.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/datasource.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "tsx --test test/*.test.ts",
    "test:ci": "tsx --test test/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/multipart": "^10.1.0",
    "bcrypt": "^6.0.0",
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "file-type": "^22.0.1",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "joi": "^18.2.3",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "tsx": "^4.23.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.67.0"
  }
}
